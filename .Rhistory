## UNIFORM POSTERIOR DISTRIBUTION
# posterior distributions, assuming 3000 posterior draws from uniform:
posterior_1 <- sort(runif(3000, 0, 10))
posterior_2 <- sort(runif(3000, 10, 20))
w <- c(0.5, 0.5)
# quantile averaging:
posterior_average_1 <- w[1] * posterior_1 + w[2] * posterior_2
hist(posterior_average_1)
# mixture distribution
mixture_samples <- function(posterior_1, posterior_2, w, n = length(posterior_1)) {
n1 <- sum(runif(n) < w[1])
n2 <- n - n1
draws1 <- sample(posterior_1, n1, replace = TRUE)
draws2 <- sample(posterior_2, n2, replace = TRUE)
sample(c(draws1, draws2))  # shuffle
}
posterior_average_2 <- mixture_samples(posterior_1, posterior_2, w)
hist(posterior_average_2)
## NORMAL POSTERIOR DISTRIBUTION ##
# posterior distributions, assuming 3000 posterior draws from normal:
posterior_1 <- sort(rnorm(3000, 5, 1.3))
hist(posterior_1); range(posterior_1)
posterior_2 <- sort(rnorm(3000, 15, 1.3))
hist(posterior_2); range(posterior_2)
w <- c(0.5, 0.5)
# quantile averaging:
posterior_average_1 <- w[1] * posterior_1 + w[2] * posterior_2
hist(posterior_average_1)
posterior_average_2 <- mixture_samples(posterior_1, posterior_2, w)
hist(posterior_average_2)
